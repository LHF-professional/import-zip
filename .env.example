# Summarizer bot — variables d'environnement
# Copie en .env et remplis les valeurs

TELEGRAM_TOKEN=
OPENAI_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=         # vide jusqu'au premier --setup

# Optionnels (enrichissement metadata)
TMDB_API_KEY=               # https://www.themoviedb.org/settings/api
GOOGLE_BOOKS_API_KEY=       # https://console.cloud.google.com (Books API)

# Torrent
TORRENT_TIMEOUT=300         # secondes, défaut 5 min
